                        "markdown": "<p></p><h1 class=\"text-center\">Partners</h1><a id=\"partners\"></a><p></p>\n<p class=\"text-center\">\nAdditional Data Provided by Our Partners<a id=\"partners\"></a><br>\n</p><center>\n<ul class=\"cards-list\">\n<li class=\"col-xs-12 col-sm-6 col-md-3\">\n<div class=\"card center-block\"><img src=\"https://maps.waterloo.ca/Images/open/City_of_Cambridge.jpg\" alt=\"Card Thumbnail\">\n<div class=\"card-options\">\n<br>\n<br>\n<a href=\"https://www.cambridge.ca/en/your-city/Open-Data.aspx\" class=\"btn btn-default btn-open\">City of Cambridge</a>\n</div><hr>\n<br>\n<p>City of Cambridge Open Data Catalogue.</p>\n</div>\n</li>\n<li class=\"col-xs-12 col-sm-6 col-md-3\">\n<div class=\"card center-block\"><img src=\"https://maps.waterloo.ca/Images/open/Region_of_Waterloo.jpg\" alt=\"Card Thumbnail\">\n<div class=\"card-options\">\n<br>\n<br>\n<a href=\"https://rowopendata-rmw.opendata.arcgis.com\" class=\"btn btn-default btn-open\">Region of Waterloo</a>\n</div><hr>\n<br>\n<p>Region of Waterloo Open Data Catalogue</p>\n</div>\n</li>\n<li class=\"col-xs-12 col-sm-6 col-md-3\">\n<div class=\"card center-block\"><center><img src=\"https://maps.waterloo.ca/Images/open/City_of_Kitchener.jpg\" alt=\"Card Thumbnail\">\n<div class=\"card-options\">\n<br>\n<br>\n<a href=\"https://open-kitchenergis.opendata.arcgis.com\" class=\"btn btn-default btn-open\">City of Kitchener</a>\n</div><hr>\n<br>\n<p>City of Kitchener Open Data Catalogue</p>\n</center></div>\n</li>\n</ul>\n</center>\n<p></p>",
                        "schemaVersion": 2.1
