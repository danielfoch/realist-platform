# CREA DDF Credentials
# The server reads CREA_DDF_USERNAME / CREA_DDF_PASSWORD (not DDF_USERNAME).
CREA_DDF_USERNAME=your_ddf_username
CREA_DDF_PASSWORD=your_ddf_password

# Database
DATABASE_URL=postgresql://user:password@host:5432/realist

# Server
PORT=3000
NODE_ENV=development
# REQUIRED: used to sign session cookies. Generate a strong random string.
SESSION_SECRET=change_me_to_a_long_random_string

# Auth (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://realist.ca/api/auth/google/callback

# Anthropic (REQUIRED for AI features: multiplex underwriter narratives + Ask Realist)
# Without it, AI narratives fall back to templates and /api/ask returns 503
# (the Ask Realist panel hides itself). Verify after deploy: GET /api/ask/status
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Mapbox (for frontend map - REQUIRED for map view)
# Get free token at https://mapbox.com
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Stripe (REQUIRED for paid features: Ask Realist premium, events, etc.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_EXPERT_PRICE_ID=
STRIPE_MEETUP_PRICE_ID=
STRIPE_ASK_REALIST_PRICE_ID=

# GoHighLevel (GHL) lead plumbing
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_URL=

# Lead routing (server/leadRouter.ts). Every inquiry reaches a human even with
# all of these unset — the defaults below are baked in. Comma-separated lists.
# Acquisition / realtor / general inquiries → Daniel
ACQUISITION_LEAD_EMAILS=danielfoch@gmail.com
# Mortgage / financing inquiries → Nick (Daniel is cc'd automatically)
FINANCING_LEAD_EMAILS=nick@bldfinancial.ca
# Optional: replace the "everyone" list (default = union of the two above)
LEAD_NOTIFY_EMAILS=
# Instant per-lead alerts from the email-trigger queue; default on. Set to
# "false" to keep only the Monday admin summary.
ADMIN_INSTANT_LEAD_ALERTS=true
# Deal Desk / weekly summary / SLA-nag recipients (fallback: LEAD_NOTIFY_EMAILS).
# The admin app setting deal_desk_notify_email overrides this when set.
DEAL_DESK_NOTIFY_EMAIL=
# General form notifications (podcast questions, reno quotes, event host and
# expert applications). Fallback: LEAD_NOTIFY_EMAILS.
PODCAST_NOTIFY_EMAIL=
NOTIFY_CC_EMAIL=
# BLD Financial forwarding for booked-call leads — leave unset until wired.
BLD_LEAD_WEBHOOK_URL=
BLD_LEAD_EMAIL=
# Owner of CRM contacts created by lead capture (default: oldest admin user).
CRM_OWNER_USER_ID=

# Replit / deployment
REPLIT_DOMAINS=realist.ca,www.realist.ca
REPLIT_DEV_DOMAIN=realist.replit.dev
REPLIT_CONNECTORS_HOSTNAME=

# Public origin used in transactional emails
PUBLIC_SITE_URL=https://realist.ca

# Meetup.com network feed (server/meetupNetwork.ts) — GET /api/meetups/network.
# Everything below is optional: with nothing set, the public iCal feeds of the
# groups registered in shared/meetupNetwork.ts are served.
# Meetup Pro network urlname (https://www.meetup.com/pro/<urlname>/).
MEETUP_PRO_URLNAME=the-canadian-real-estate-investor
# Comma-separated extra group urlnames merged with the registry.
MEETUP_GROUP_URLNAMES=
# Static OAuth bearer token; when set, the JWT flow below is skipped.
MEETUP_ACCESS_TOKEN=
# OAuth2 JWT server flow (Meetup OAuth consumer with a registered RSA public
# key). Enables the GraphQL branch: automatic group discovery, RSVP counts,
# event photos. The private key may be pasted on one line with literal \n.
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
MEETUP_JWT_PRIVATE_KEY=
MEETUP_AUTHORIZED_MEMBER_ID=

# --- Meetup.com member OAuth + in-page RSVP (server/meetupOAuth.ts) ---
# Dormant until MEETUP_CLIENT_ID and MEETUP_CLIENT_SECRET are set.
# Redirect URI registered on the consumer; defaults to <site>/api/meetup/oauth/callback
MEETUP_OAUTH_REDIRECT_URI=
# Optional scope string for the authorize URL (leave empty unless Meetup requires one)
MEETUP_OAUTH_SCOPE=
# Full GraphQL mutation document with a single `$eventId: ID!` variable. Set only
# after confirming the member RSVP mutation in Meetup's schema; enables in-page RSVP.
MEETUP_RSVP_MUTATION_DOCUMENT=
