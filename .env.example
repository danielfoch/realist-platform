# --- Database (Neon Postgres) ---
DATABASE_URL=

# Any Postgres works: *.neon.tech URLs use Neon's HTTP driver, anything else uses `pg`.
# After setting it: `npm run db:push`.

# --- Accounts ---
# Transactional email (sign-in links). Without it, "email me a link" is hidden —
# and most members migrated from the legacy app have no password, so set this
# before cutover. The sending domain must be verified in Resend.
RESEND_API_KEY=
# Optional; defaults to "Realist <hello@realist.ca>".
EMAIL_FROM=
# Google sign-in. The redirect URI is NEXT_PUBLIC_SITE_URL + /api/auth/google/callback
# (the same path the legacy app used) and must be listed on the OAuth client in
# Google Cloud. People must start sign-in on that same host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI.
GOOGLE_REDIRECT_URI=
# One-off, local only — never set on Vercel. The legacy realist.ca database,
# read (read-only) by `npm run migrate:users`.
SOURCE_DATABASE_URL=

# --- Leads → CRM (lib/leads) ---
# Every form posts to /api/leads; each lead is committed, then delivered from an
# outbox (retried by /api/cron/leads). Anything left unset simply WAITS: leads
# captured before a key exists are delivered once it does.
# GoHighLevel API v2: a Private Integration token with contacts write scope
# (Settings → Private Integrations) and the sub-account's location id.
# HIGHLEVEL_TOKEN / HIGHLEVEL_LOCATION_ID are accepted as aliases.
GHL_API_KEY=
GHL_LOCATION_ID=
# And/or an "Inbound Webhook" workflow trigger URL (same payload the old app sent).
GHL_WEBHOOK_URL=
# Who gets emailed. Comma-separated. Financing leads copy the acquisition list.
ACQUISITION_LEAD_EMAILS=
FINANCING_LEAD_EMAILS=
# Set to 1 to also be emailed for plain signups (they always reach the CRM).
LEAD_EMAIL_SIGNUPS=
# Keypr cash-back handoff (Ontario offers with partner consent only).
KEYPR_REALIST_SECRET=

# --- Offer ---
# Share of the buyer-side commission rebated at closing. Shown everywhere the
# offer is mentioned; must match what the partner brokerage actually pays.
NEXT_PUBLIC_CASHBACK_PERCENT=

# --- Site ---
# Canonical base URL. Leave unset in production once realist.ca points here;
# set to https://new.realist.ca during the transition.
NEXT_PUBLIC_SITE_URL=

# --- CREA DDF (RESO Web API, OAuth2 client credentials) ---
CREA_DDF_USERNAME=
CREA_DDF_PASSWORD=

# --- Anthropic (multiplex report narration, podcast enrichment) ---
ANTHROPIC_API_KEY=

# --- Meetup.com (community integration; OAuth consumer) ---
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
# The group whose events power /community, e.g. the CREI meetup group urlname.
# The public iCal feed for this group works with zero auth — this is the only
# variable /community requires.
MEETUP_GROUP_URLNAME=
# Optional upgrade: with a token available, /community queries the Meetup
# GraphQL API for RSVP counts + event images, falling back to iCal on error.
# Preferred: the JWT server flow (lib/community/meetupAuth.ts). On the OAuth
# client page click "Create Signing Key"; the private key is shown ONCE.
# It is an RSA PEM ("-----BEGIN PRIVATE KEY-----"), not the client secret.
MEETUP_JWT_PRIVATE_KEY=
# Key id listed beside the signing key on the client page (JWT `kid`).
MEETUP_JWT_KEY_ID=
# Member id of the Pro network's primary admin (meetup.com/members/<id>).
MEETUP_AUTHORIZED_MEMBER_ID=
# Alternative: a static bearer token; when set, the JWT flow is skipped.
MEETUP_ACCESS_TOKEN=

# --- Cron protection (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Maps (listings map) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

